# SecureX Platform Environment Configuration

# Application
VITE_APP_NAME=SecureX
VITE_APP_ENV=development

# API Configuration
VITE_API_URL=http://localhost:8080/api/v1
VITE_BLOCKCHAIN_API_URL=http://localhost:8081/api/v1
VITE_FRAUD_ENGINE_URL=http://localhost:8082/api/v1

# Mock Mode (set to false when backend is connected)
VITE_IS_MOCK=true

# Authentication
VITE_AUTH_STORAGE_KEY=securex_auth_token
