# SecureX Platform Environment Configuration
#
# This file documents the environment variables read by the frontend (VITE_*,
# see src/constants/index.ts) and by the backend Platform API (server/config.ts).
# Copy to .env for local development. Frontend vars are inlined at build time by
# Vite; backend vars are read from the process environment at runtime by the
# Node server (tsx dev or dist-server production build).
#
# No secrets belong in this file. Secrets (JWT_SECRET, DATABASE_URL password)
# are supplied via the host environment / Render dashboard, never committed.

# ─────────────────────────────────────────────────────────────────────
# Frontend (src/constants/index.ts) — everything a browser can hold.
# NEVER place secrets in any VITE_ variable: it is shipped to the client.
# ─────────────────────────────────────────────────────────────────────

# The platform/main API service (SecureX Platform API).
# REQUIRED on Vercel. Production value:
#   VITE_API_BASE_URL=https://api-securex.sp-net.in/api
VITE_API_BASE_URL=http://localhost:4000/api

# NOTE: there is deliberately NO VITE_BLOCKCHAIN_API_URL, VITE_FRAUD_ENGINE_URL
# or VITE_BLOCKCHAIN_AUTH_TOKEN. The browser must not address the blockchain or
# fraud services directly and must never hold a service credential: every chain
# operation is proxied server-side by the Platform API
# (server/routes/blockchain.ts -> server/services/blockchain.ts), which
# authorizes the caller first. The equivalent server-side names are
# BLOCKCHAIN_API_URL / BLOCKCHAIN_AUTH_TOKEN / FRAUD_ENGINE_URL (below).

# Mock Mode (set to false when the backend is connected)
#
#   VITE_USE_MOCK=true   -> DEMO mode: rich mock data, no network calls
#   VITE_USE_MOCK=false  -> REAL mode: calls the live Platform API
#
# DEMO is EXPLICIT OPT-IN and fails closed: any value other than the exact
# string "true" (including unset) resolves to REAL mode.
VITE_USE_MOCK=true

# ─────────────────────────────────────────────────────────────────────
# Backend — Platform API (server/config.ts). Read at server runtime; absent
# values fall back to safe local-development defaults unless noted.
# ─────────────────────────────────────────────────────────────────────

# Environment. 'production' enforces fail-closed rules below.
# APP_ENV=production
# DATA_MODE=real

# PostgreSQL connection string. REQUIRED in production (fail-closed).
# DATABASE_URL=postgres://user:password@host:5432/securex

# Connection pool size for the Platform API (default 10).
# DATABASE_POOL_MAX=10

# JWT signing secret. REQUIRED in production (fail-closed, min 32 chars,
# must not match the dev fallback).
# JWT_SECRET=replace-with-a-long-random-secret

# Exact allowed browser origins, comma-separated. REQUIRED in production
# (fail-closed); "*" is rejected. Frontend hosts only.
# CORS_ORIGINS=https://app-securex.sp-net.in

# Seed the canonical demo domain data on boot of a FRESH database only.
# Existing databases are never reseeded or overwritten.
#
# DANGER: the seed creates privileged accounts (ADMIN, SECURITY_ADMIN,
# NETWORK_ADMIN, AUDITOR) that all share the plaintext password "Password123!",
# plus synthetic sessions and fake ledger history. It therefore DEFAULTS TO
# FALSE in production and TRUE in every other environment. Leave it unset (or
# "false") on any real deployment. Set it to "true" only for a deliberately
# provisioned DEMO deployment.
# SEED_ON_BOOT=false

# Allow DATA_MODE=demo under APP_ENV=production. The server REFUSES TO BOOT
# otherwise. Only set this to "allow" for an isolated demo deployment.
# ALLOW_DEMO_DATA=allow

# Downstream specialized services (SecureX Blockchain, SecureX Fraud Engine),
# probed by the Security Center health report. Server-side only: never expose
# these as VITE_* variables.
# BLOCKCHAIN_API_URL=http://localhost:3001
# FRAUD_ENGINE_URL=http://localhost:4002/fraud

# Credential presented to the blockchain service. Server-side only, never a
# VITE_* variable. When empty, privileged chain operations are refused with an
# explicit UNAVAILABLE result rather than attempted unauthenticated.
# BLOCKCHAIN_AUTH_TOKEN=

# Render deployment notes (free plan): the blockchain and fraud engine are
# PUBLIC web services (free instances cannot receive private-network traffic),
# so on Render set these to their *.onrender.com URLs, e.g.
#   BLOCKCHAIN_API_URL=https://securex-blockchain-XXXX.onrender.com
#   FRAUD_ENGINE_URL=https://securex-fraud-engine-XXXX.onrender.com/fraud
# There is deliberately NO Vercel/frontend counterpart: the browser never
# addresses these services (see the note above).
# Full runbook: docs/deployment-render.md

# HTTP binding (Render sets PORT automatically).
# HOST=0.0.0.0
# PORT=4000

# Integration test database (defaults to postgres://localhost:5432/securex_test
# in the test environment). Must be a dedicated *test* database.
# TEST_DATABASE_URL=postgres://localhost:5432/securex_test

# ─────────────────────────────────────────────────────────────────────
# One-time ADMIN bootstrap — server-side CLI ONLY. No HTTP route, no
# browser code path, no VITE_ variable. See docs/deployment-render.md.
# ─────────────────────────────────────────────────────────────────────
#
# Why: with SEED_ON_BOOT=false a production database starts with ZERO users,
# and public registration intentionally cannot create privileged roles
# (server/routes/auth.ts allows only HOLDER/INSTITUTION/ISSUER/EMPLOYER), so
# without this there is no supported way to create the first administrator.
#
# Set these five variables in the service environment, run
# `npm run bootstrap:admin` once (Render: Shell / one-off job), verify the
# account, then DELETE the four BOOTSTRAP_ADMIN_* variables.
#
#   BOOTSTRAP_ADMIN_SECRET     >= 32 chars, generated randomly. Stored in the
#                              service environment. Proves the operator is
#                              authorized to create the account.
#   BOOTSTRAP_ADMIN_TOKEN      the same value, re-supplied when the command is
#                              run. Compared with BOOTSTRAP_ADMIN_SECRET in
#                              constant time. Set it only for the run, then
#                              remove it.
#   BOOTSTRAP_ADMIN_EMAIL      the admin's login email.
#   BOOTSTRAP_ADMIN_NAME       the admin's display name.
#   BOOTSTRAP_ADMIN_PASSWORD   the admin's password (hashed with bcrypt on
#                              insert; never logged, never returned).
#
# The command is a one-time operation: it refuses if ANY ADMIN already exists,
# creates exactly one ADMIN and nothing else, and is safe to re-run (it is a
# refusal, not a duplicate insert). It must never be wired to a route.
# BOOTSTRAP_ADMIN_SECRET=
# BOOTSTRAP_ADMIN_TOKEN=
# BOOTSTRAP_ADMIN_EMAIL=admin@sp-net.in
# BOOTSTRAP_ADMIN_NAME=Platform Administrator
# BOOTSTRAP_ADMIN_PASSWORD=