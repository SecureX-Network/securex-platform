# SecureX Platform Environment Configuration
#
# These are the only environment variables read by the application
# (see src/constants/index.ts). No secrets, tokens, private keys, or
# credentials belong here.

# API Configuration (defaults match src/constants)
# The platform/main API service.
VITE_API_BASE_URL=http://localhost:4000/api
# The SecureX Blockchain V2 REST API (securex-blockchain). Default node port is 3001;
# routes are served at the root (no /blockchain path prefix).
VITE_BLOCKCHAIN_API_URL=http://localhost:3001
# The fraud/tampering engine service.
VITE_FRAUD_ENGINE_URL=http://localhost:4002/fraud

# Mock Mode (set to false when backend is connected)
#
#   VITE_USE_MOCK=true   -> DEMO mode: rich mock data, no network calls
#   VITE_USE_MOCK=false  -> REAL mode: holder-admin pages read live SecureX
#                           blockchain state (issuers, credentials, lifecycle,
#                           verification, QR, tamper-check, audit) from
#                           VITE_BLOCKCHAIN_API_URL.
VITE_USE_MOCK=true

# Optional: forwarding token for privileged backend endpoints. The SecureX
# backend dev/demo authenticator (SharedSecretAuthenticator, configured via
# CTN_AUTH_TOKENS) accepts "role:secret" bearer tokens. In REAL mode credential
# lifecycle writes (reinstate/revoke/reissue) require issuer-level signing that a
# browser does not hold; configure a privileged principal at the backend for those.
# VITE_BLOCKCHAIN_AUTH_TOKEN=
