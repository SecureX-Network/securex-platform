# SecureX Platform Environment Configuration
#
# This file documents the environment variables read by the frontend (VITE_*,
# see src/constants/index.ts) and by the backend Platform API (server/config.ts).
# Copy to .env for local development. Frontend vars are inlined at build time by
# Vite; backend vars are read from the process environment at runtime by the
# Node server (tsx dev or dist-server production build).
#
# No secrets belong in this file. Secrets (JWT_SECRET, DATABASE_URL password)
# are supplied via the host environment / Render dashboard, never committed.

# ─────────────────────────────────────────────────────────────────────
# Frontend (src/constants/index.ts) — everything a browser can hold.
# NEVER place secrets in any VITE_ variable: it is shipped to the client.
# ─────────────────────────────────────────────────────────────────────

# The platform/main API service (SecureX Platform API).
VITE_API_BASE_URL=http://localhost:4000/api

# Downstream services used by the frontend in REAL mode. Defaults match the
# local microservice defaults (securex-blockchain :3001, securex-fraud-engine :4002).
VITE_BLOCKCHAIN_API_URL=http://localhost:3001
VITE_FRAUD_ENGINE_URL=http://localhost:4002/fraud

# Mock Mode (set to false when the backend is connected)
#
#   VITE_USE_MOCK=true   -> DEMO mode: rich mock data, no network calls
#   VITE_USE_MOCK=false  -> REAL mode: calls live Platform/Blockchain/Fraud services
VITE_USE_MOCK=true

# ─────────────────────────────────────────────────────────────────────
# Backend — Platform API (server/config.ts). Read at server runtime; absent
# values fall back to safe local-development defaults unless noted.
# ─────────────────────────────────────────────────────────────────────

# Environment. 'production' enforces fail-closed rules below.
# APP_ENV=production
# DATA_MODE=real

# PostgreSQL connection string. REQUIRED in production (fail-closed).
# DATABASE_URL=postgres://user:password@host:5432/securex

# Connection pool size for the Platform API (default 10).
# DATABASE_POOL_MAX=10

# JWT signing secret. REQUIRED in production (fail-closed, min 32 chars,
# must not match the dev fallback).
# JWT_SECRET=replace-with-a-long-random-secret

# Exact allowed browser origins, comma-separated. REQUIRED in production
# (fail-closed); "*" is rejected. Frontend hosts only.
# CORS_ORIGINS=https://app-securex.sp-net.in

# Seed the canonical demo domain data on boot of a FRESH database only.
# Existing databases are never reseeded or overwritten. Leave true for the
# first deploy; set to false afterwards if desired.
# SEED_ON_BOOT=true

# Downstream specialized services (SecureX Blockchain, SecureX Fraud Engine),
# probed by the Security Center health report.
# BLOCKCHAIN_API_URL=http://localhost:3001
# FRAUD_ENGINE_URL=http://localhost:4002/fraud

# Render deployment notes (free plan): the blockchain and fraud engine are
# PUBLIC web services (free instances cannot receive private-network traffic),
# so on Render set these to their *.onrender.com URLs, e.g.
#   BLOCKCHAIN_API_URL=https://securex-blockchain-XXXX.onrender.com
#   FRAUD_ENGINE_URL=https://securex-fraud-engine-XXXX.onrender.com/fraud
# The frontend counterpart (VITE_BLOCKCHAIN_API_URL) is set on Vercel.
# Full runbook: docs/deployment-render.md

# HTTP binding (Render sets PORT automatically).
# HOST=0.0.0.0
# PORT=4000

# Integration test database (defaults to postgres://localhost:5432/securex_test
# in the test environment). Must be a dedicated *test* database.
# TEST_DATABASE_URL=postgres://localhost:5432/securex_test