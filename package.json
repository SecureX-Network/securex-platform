{
  "name": "securex-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SecureX — Blockchain-Powered Digital Credential Trust Network",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:server": "rm -rf dist-server && tsc -p server/tsconfig.build.json && cp server/db/schema.sql dist-server/db/schema.sql",
    "start": "node dist-server/index.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:server": "tsx --test --test-force-exit --test-reporter=spec server/test/*.test.ts",
    "test:all": "npm run lint && npm run typecheck && npm test && npm run test:server && npm run build && npm run build:server",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 5",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "server": "tsx server/index.ts",
    "server:watch": "tsx watch server/index.ts",
    "import:sqlite": "tsx server/scripts/import-sqlite.ts"
  },
  "dependencies": {
    "@types/node": "^26.5.0",
    "bcryptjs": "^2.4.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.460.0",
    "pg": "^8.23.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.13.0",
    "vite": "^6.0.1",
    "vitest": "^2.1.5"
  }
}
